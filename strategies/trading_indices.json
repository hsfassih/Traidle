      "summary": "On indices, the daily sequence flips between AM and PM expansion depending on whether the higher-timeframe objective is reached before 08:30 New York. Trade the designated expanding session with a sweep-and-fair-value-gap entry while treating the presenter's AM and PM windows as custom equity-session time blocks.",
      "direction": "both",
      "symmetric": true,
      "timeframes": {
        "bias_tf": "4h|1d",
        "setup_tf": "5m|15m",
        "entry_tf": "1m",
        "strict": false,
        "notes": "bias_tf names the higher-timeframe objective (commonly 4h or 1d). setup_tf provides the session-sequence context, while entry_tf is the preferred 1m execution chart for indices; some examples align a 5m FVG with the 1m entry."
      },
      "requires_context": {
