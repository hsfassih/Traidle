    {
      "strategy_id": "daily_bias_via_fvg_reading",
      "aliases": [],
      "category": "htf_continuation",
      "summary": "Determine the daily bias by reading the sequence of fair value gaps (FVGs) on the daily timeframe in context with weekly PD arrays. Strong bias is confirmed when price respects (wicks into) fair value gaps in the direction of the trend and disrespects (closes through) counter-trend fair value gaps.",
      "direction": "both",
      "symmetric": true,
      "timeframes": {
        "bias_tf": "weekly",
        "setup_tf": "daily",
        "entry_tf": null,
        "strict": false,
        "notes": "The daily timeframe must be read in the context of the weekly timeframe (fractal alignment)."
      },
      "requires_context": {
        "bias": [
          "weekly_fvg"
        ],
        "session": [],
        "time_window_ny": null,
        "day_of_week": null,
        "other": []
      },
      "glossary": {
        "respect": "Price wicking into a fair value gap without closing fully through it, indicating the gap is holding.",
        "disrespect": "Price closing fully above or below a fair value gap (closing inside or through it), indicating the gap has failed as support/resistance."
      },
      "signals_required": [
        {
          "step": 1,
          "signal": "fvg.bullish",
          "equals": true,
          "timeframe": "setup_tf",
          "optional": false,
          "max_candles_after_previous_step": null,
          "traidle_supported": true,
          "provenance": "presenter_stated",
          "ts": "00:01:45"
        },
        {
          "step": 2,
          "signal": "candle.close",
          "gt": "fvg.gap_high",
          "timeframe": "setup_tf",
          "optional": true,
          "max_candles_after_previous_step": 5,
          "traidle_supported": true,
          "provenance": "inferred",
          "ts": "00:04:05"
        }
      ],
      "custom_signals": [
        {
          "name": "leg_strength",
          "kind": "other",
          "plain_definition": "A price leg is strong if it contains an FVG; it is weak if it does not contain an FVG.",
          "numeric_definition": null,
          "definition_source": "presenter_stated",
          "ts": "00:03:27"
        },
        {
          "name": "context_conflict",
          "kind": "other",
          "plain_definition": "A daily FVG is low probability if there is an opposing weekly FVG sitting right behind it.",
          "numeric_definition": null,
          "definition_source": "presenter_stated",
          "ts": "00:04:42"
        }
      ],
      "sequence": [
        "Identify a directional price leg on the daily timeframe that leaves a Fair Value Gap (FVG).",
        "Check the context on the Weekly timeframe. Ensure there is no opposing Weekly FVG immediately in the path of the Daily leg.",
        "Wait for price to retrace into the Daily FVG.",
        "Observe the reaction. A 'strong' FVG will be respected (wicked into but not closed through) in one or very few attempts.",
        "If the Daily FVG is respected, form a directional bias aiming for the next liquidity pool (a leg lacking an FVG or an opposing premium/discount array).",
        "If opposing Daily FVGs are disrespected (price closes through them), this further confirms the initial bias.",
        "Sacrifice the first day of the reaction (the wick) to confirm the bias for the subsequent days."
      ],
      "invalidation": [
        {
          "text": "The Daily FVG is 'disrespected' if a daily candle body closes entirely through it (e.g., closing below a bullish FVG).",
          "provenance": "presenter_stated",
          "ts": "00:10:57"
        },
        {
          "text": "The bias becomes low probability if price requires multiple deep retracements (stings) into the FVG over many days before expanding.",
          "provenance": "presenter_stated",
          "ts": "00:07:05"
        }
      ],
      "filters": [
        {
          "text": "Do not trade towards a lower timeframe FVG (like 5m or 1m) for daily bias context; use 4H, Daily, Weekly, Monthly.",
          "provenance": "presenter_stated",
          "ts": "00:10:32"
        },
        {
          "text": "Avoid trading neutral days. If the bias is unclear or price action is low probability, do not trade.",
          "provenance": "presenter_stated",
          "ts": "00:08:48"
        }
      ],
      "entry_rule": {
        "text": "The entry model is independent of the bias determination. Any entry model can be used once the bias is established.",
        "structured": null,
        "provenance": "presenter_stated",
        "ts": "00:00:32",
        "quote": "the entry model is completely irrelevant you can get very creative with your Edge model"
      },
      "target_rule": {
        "text": "Target the opposing premium or discount array, specifically legs of price action that do not contain Fair Value Gaps (draw on liquidity).",
        "structured": null,
