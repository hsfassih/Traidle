  "sequence": [
    "Identify higher-timeframe context: price reacting from a HTF discount array and targeting the first HTF premium array.",
    "Drop down to the corresponding lower timeframe (e.g., Monthly to Daily/4H, or Weekly/1H to 5m) within the context of the HTF expansion.",
    "Observe the ST (first FVG), which provides an initial early reversal indication confirming an intermediate term low.",
    "Wait for confirmation via the creation of subsequent fair value gaps forming a confirmed short-term range (higher probability than the ST).",
    "Enter on a retracement into the short-term range fair value gap, especially when overlapping with an order block or breaker block.",
    "Place the stop loss below the protected low where price has already mitigated a prior PD array and has no reason to return.",
    "Target the opposing intermediate term high or higher timeframe premium array, or exit at a static 1:2 Risk:Reward ratio."
  ],
  "invalidation": [
    {
      "text": "Price closes below the protected low that established the short-term range and mitigated the prior discount array.",
      "provenance": "presenter_stated",
      "ts": "20:36"
    },
    {
      "text": "Attempting to trade inside Seek and Destroy / consolidation ranges where higher-timeframe context has not yet formed.",
      "provenance": "presenter_stated",
      "ts": "12:50"
    }
  ],
  "filters": [
    {
      "text": "Do not follow low-timeframe (e.g., 5-minute) continuation blindly without checking higher timeframe context; deep retracements into 15m/1H PD arrays will cause stop-outs.",
      "provenance": "presenter_stated",
      "ts": "21:54"
    },
    {
      "text": "Expansion days require volatility drivers; trade when price context aligns with high-impact economic news events (e.g., USD news on Wednesdays).",
      "provenance": "presenter_stated",
      "ts": "14:43"
    },
    {
      "text": "Friday is generally not known as a trending day; avoid expecting strong multi-timeframe expansion.",
      "provenance": "presenter_stated",
      "ts": "28:54"
    },
    {
      "text": "Avoid trading during low-probability consolidation phases; wait patiently for a new retracement to create new context.",
      "provenance": "presenter_stated",
      "ts": "01:48"
    }
  ],
  "entry_rule": {
    "text": "Enter on a retracement into a short-term range containing a fair value gap, ideally overlapping with an order block or breaker block, following the ST confirmation.",
