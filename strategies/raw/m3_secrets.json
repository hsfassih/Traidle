  "summary": "Establishes higher timeframe context by identifying price moving from a discount array to a premium array (or vice versa). Lower timeframe short-term ranges containing fair value gaps are then traded toward the higher timeframe target once the reversal is confirmed.",
  "direction": "both",
  "symmetric": true,
  "timeframes": {
    "bias_tf": "Monthly | Weekly | Daily | 1h",
    "setup_tf": "Daily | 4h | 1h | 15m",
    "entry_tf": "1h | 15m | 5m",
    "strict": false,
    "notes": "Fully fractal. Entry timeframes must be in context of the timeframe directly above them (e.g., Monthly context down to Daily/4H; Weekly down to 1H; 1H down to 5m)."
  },
