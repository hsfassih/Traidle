        "ts": "07:08"
      }
    ],
    "filters": [
      {
        "text": "Do not execute on multiple pairs at once; maximum 2% total account risk, meaning maximum two 1% setups simultaneously.",
        "provenance": "presenter_stated",
        "ts": "14:04"
      },
      {
        "text": "Ideally, enter trades on a Monday, Tuesday, or Wednesday to catch the weekly range expansion.",
