    "category": "htf_continuation",
    "summary": "A fractal swing-trading system operating on Monthly, Weekly, or Daily contexts. It waits for a tap into a higher-timeframe array, executes the 'original entry' on a designated lower timeframe upon the first overlapping ST/FVG, scales out partially/goes breakeven early, and allows a higher-timeframe 're-entry' after the first trade's objective is secured.",
    "direction": "both",
    "symmetric": true,
    "timeframes": {
      "bias_tf": "1M | 1W | 1D",
      "setup_tf": "4H | 1H",
      "entry_tf": "4H | 1H",
      "strict": true,
      "notes": "Context -> Original Entry -> Re-entry mappings: Monthly context uses 4H entry then Daily re-entry. Weekly context uses 1H entry then 4H re-entry. Daily context uses 1H entry then 4H re-entry."
    },
    "requires_context": {
      "bias": [
