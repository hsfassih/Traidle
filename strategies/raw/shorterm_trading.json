        "bearish"
      ],
      "session": [],
      "time_window_ny": null,
      "day_of_week": "Monday, Tuesday, or Wednesday",
      "other": [
        "Must have a clear context: price moving from a Discount array to a Premium array (or vice versa) on the bias timeframe."
      ]
    },
    "glossary": {
      "Original Entry": "The first entry taken on a lower timeframe after price taps the higher timeframe context array.",
      "Re-entry Opportunity": "A secondary, higher-timeframe entry taken on the way to the final target, but ONLY considered if the original entry was already taken and is at least at breakeven.",
      "ST": "A fair value gap that forms in the desired direction (used interchangeably with standard displacement in this video).",
      "Overlapping Entry": "Entering on a short-term range's fair value gap that overlaps with another PD array (like an order block or a prior high/low).",
      "FLOD": "First Line of Defense.",
      "LLOD": "Last Line of Defense."
    },
