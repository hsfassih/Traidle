{
  "strategy_id": "market_structure_secrets",
  "aliases": [
    "ST Model",
    "Short Term Ranges",
    "Intermediate Term Structure"
  ],
  "category": "trend_following",
  "summary": "Trading short-term ranges between an established Intermediate Term High (ITH) and the target Intermediate Term Low (ITL). High-probability entries are taken at confirmed short-term highs that leave a fair value gap, ensuring the setup timeframe is in context of the timeframe above it.",
  "direction": "both",
  "symmetric": true,
  "timeframes": {
    "bias_tf": "HTF",
    "setup_tf": "LTF",
    "entry_tf": null,
    "strict": false,
    "notes": "The trading timeframe must always be in context of the timeframe immediately above it (e.g., 1H trading in context of Daily/4H arrays)."
  },
  "requires_context": {
    "bias": [],
    "session": [],
    "time_window_ny": null,
    "day_of_week": null,
    "other": [
      "Price must be navigating between an ITH and an ITL"
    ]
  },
  "glossary": {
    "INTERMEDIATE_TERM_HIGH": "A swing high positioned between a short-term high that is lower to its left and a short-term high that is lower to its right. It forms at a premium array on the timeframe above it.",
    "INTERMEDIATE_TERM_LOW": "A swing low positioned between a short-term low that is higher to its left and a short-term low that is higher to its right.",
    "SHORT_TERM_HIGH": "A swing high that leaves a fair value gap in the leg lower. It acts as a protected last line of defense in a bearish trend.",
    "ST_MODEL": "Taking a risky, early entry on the very first fair value gap lower to catch the swing high that will eventually confirm the Intermediate Term High."
  },
