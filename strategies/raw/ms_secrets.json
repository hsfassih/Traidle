  "sequence": [
    "Wait for an Intermediate Term Low to be taken out, which initiates a larger market retracement.",
    "Price retraces into a PD array found on the timeframe directly above your trading timeframe (e.g., a Daily Premium Array if trading on the 1H).",
    "At this higher-timeframe array, a new Intermediate Term High forms.",
    "The initial entry (ST Model) is the very first fair value gap lower that forms this ITH, which is higher risk.",
    "As price moves from the new ITH toward the next ITL target, it generates Short Term Ranges.",
    "Wait for a swing high to leave a fair value gap lower, confirming it as a Short Term High.",
    "Trade these short-term ranges, trusting the Short Term High to be respected as the last line of defense until the target is hit."
  ],
  "invalidation": [
    {
      "text": "If a bullish fair value gap gets respected and price closes above the protecting short-term high, the high is disrespected and the setup is invalid.",
      "provenance": "presenter_stated",
      "ts": "04:18"
    }
  ],
  "filters": [
    {
      "text": "Do not justify the existence of fair value gaps by dropping down in timeframes. Always go up in timeframes to justify context.",
      "provenance": "presenter_stated",
      "ts": "07:11"
    }
  ],
