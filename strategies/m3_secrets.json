      "custom_signals": [
        {
          "name": "htf_pd_array_tap",
          "kind": "price_action",
          "plain_definition": "Price trades into a higher-timeframe discount array (bullish) or premium array (bearish), such as a fair value gap or order block.",
          "numeric_definition": "(low <= bullish_fvg[0].gap_high@bias_tf AND high >= bullish_fvg[0].gap_low@bias_tf AND NOT bullish_fvg[0].filled@bias_tf) OR (low <= bullish_ob[0].zone_high@bias_tf AND high >= bullish_ob[0].zone_low@bias_tf AND NOT bullish_ob[0].invalidated@bias_tf)",
          "definition_source": "inferred",
          "ts": "02:49"
        },
        {
          "name": "first_fvg_after_array_tap",
          "kind": "candle_pattern",
          "plain_definition": "The very first fair value gap that forms in the trade direction after price taps the higher-timeframe PD array.",
          "numeric_definition": "bullish_fvg[0].formed AND any(custom_signals.htf_pd_array_tap, K_TAP_LOOKBACK_CANDLES) AND count(bullish_fvg[0].formed, K_TAP_LOOKBACK_CANDLES) == 1",
          "definition_source": "inferred",
          "ts": "06:56"
        },
        {
          "name": "short_term_range",
          "kind": "price_action",
          "plain_definition": "A directional swing (swing low to swing high for longs) containing a fair value gap that has not been closed through and holds price on pullbacks.",
          "numeric_definition": "swing_high[0].open_time > swing_low[0].open_time AND bullish_fvg[0].confirmed_at > swing_low[0].open_time AND NOT bullish_fvg[0].filled",
          "definition_source": "inferred",
          "ts": "07:17"
        },
        {
          "name": "fvg_touched",
          "kind": "price_action",
          "plain_definition": "Price trades into the fair value gap (a touch or sting), without requiring the consequent encroachment.",
          "numeric_definition": "low <= fvg.gap_high AND NOT fvg.filled",
          "definition_source": "presenter_stated",
          "ts": "19:52"
        },
        {
          "name": "htf_opposing_pd_array",
          "kind": "level",
          "plain_definition": "The opposing higher-timeframe premium array (for longs) that acts as the draw on liquidity.",
          "numeric_definition": "NOT bearish_fvg[0].filled@bias_tf",
          "definition_source": "inferred",
          "ts": "03:14"
        },
        {
          "name": "consolidation",
          "kind": "price_action",
          "plain_definition": "Sideways price action with no expansion over a recent window.",
          "numeric_definition": "highest(high, K_CONSOLIDATION_CANDLES) - lowest(low, K_CONSOLIDATION_CANDLES) <= K_CONSOLIDATION_RANGE_ATR * atr",
          "definition_source": "inferred",
          "ts": "01:48"
        }
      ],
      "sequence": [
        "Wait for price to tap the higher-timeframe discount array that sets the directional draw.",
        "The aggressive ST-model variation is the first bullish FVG that forms away from that tap.",
        "For the preferred trade, wait for a later bullish FVG that defines a protected short-term range on the execution chart.",
        "Let price retrace into that short-term-range FVG while the protected low stays intact.",
        "Trade the continuation toward the opposing higher-timeframe premium array."
      ],
      "invalidation": [
