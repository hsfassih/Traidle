      "category": "htf_continuation",
      "summary": "Use higher-timeframe PD-array context to trade the lower-timeframe continuation from an early ST-model FVG into later short-term-range retracements. The preferred target is the opposing higher-timeframe PD array while the protected short-term low remains intact.",
      "direction": "both",
      "symmetric": true,
      "timeframes": {
        "bias_tf": "1mo|1w|1d|1h",
        "setup_tf": "1d|4h|1h|15m",
        "entry_tf": "1h|15m|5m",
        "strict": false,
        "notes": "Fully fractal. setup_tf is the first lower timeframe used to confirm the reaction off bias_tf, and entry_tf is the same chart or the next lower contract-ladder rung used for the short-term-range retracement (for example 1mo -> 1d/4h, 1w -> 1h, 1h -> 5m)."
      },
